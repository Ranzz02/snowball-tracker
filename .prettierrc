{
	"$schema": "https://json.schemastore.org/prettierrc",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 100,
	"semi": true,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"trailingComma": "all",
	"arrowParens": "always",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"endOfLine": "lf",
	"overrides": [
		{
			"files": ["*.yml", "*.yaml", "*.md"],
			"options": { "useTabs": false, "tabWidth": 2 }
		},
		{
			"files": ["package.json"],
			"options": { "useTabs": false, "tabWidth": 2 }
		}
	]
}
